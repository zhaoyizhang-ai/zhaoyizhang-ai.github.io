{
  "name": "zhaoyizhang-ai-github-io",
  "version": "1.0.0",
  "private": true,
  "description": "Personal website and blog built with Academic Pages and Jekyll",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhaoyizhang-ai/zhaoyizhang-ai.github.io.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22 <26"
  },
  "dependencies": {
    "jquery": "3.7.1"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.0",
    "uglify-js": "3.19.3"
  },
  "scripts": {
    "build:js": "uglifyjs node_modules/jquery/dist/jquery.min.js assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js assets/js/theme.js -c -m -o assets/js/main.min.js",
    "lint:md": "markdownlint-cli2 README.md CUSTOMIZE_ME.md '_posts/**/*.md' '_notes/**/*.md' '_pages/**/*.md' '_drafts/**/*.md' 'assets/images/**/README.md' 'files/**/README.md'",
    "test": "npm run lint:md"
  }
}
